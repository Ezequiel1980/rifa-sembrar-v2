rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // users — lectura propia o admin; creación propia (primer login); edición propia solo campos no críticos
    match /users/{userId} {
      allow read:   if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // config — lectura autenticados; escritura solo admin
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // tickets — lectura autenticados; creación usuario propio con status reservado; edición/borrado admin
    // usuarios pueden borrar solo sus propias reservas (no tickets pagados)
    match /tickets/{ticketId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "reserved";
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid && resource.data.status == "reserved");
    }
  }
}
