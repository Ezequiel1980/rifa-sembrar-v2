rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // users — lectura propia o admin; creación propia (primer login); edición propia o admin
    match /users/{userId} {
      allow read:   if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // config — lectura autenticados; escritura solo admin
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // tickets — lectura autenticados; creación usuario propio; edición/borrado admin
    match /tickets/{ticketId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
